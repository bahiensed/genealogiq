generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  OWNER
  ADMIN
  COMERCIAL
  FINANCE
  USER
}

enum EmailTokenType {
  VERIFICATION
  CHANGE
}

enum EntityType {
  INDIVIDUAL
  COMPANY
}

// ─── Subscriptions & Packages ────────────────────────────────────────────────

model Subscription {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  isActive    Boolean @default(true) @map("is_active")

  // Commercial
  maxProfiles Int     @map("max_profiles")
  termLength  Int     @map("term_length")
  price       Decimal @db.Decimal(10, 2)

  // Feature limits
  treeMaxMembers   Int @map("tree_max_members")
  bioMaxChars      Int @map("bio_max_chars")
  bioMaxImages     Int @map("bio_max_images")
  galleryMaxImages Int @map("gallery_max_images")
  galleryMaxVideos Int @map("gallery_max_videos")

  // Feature flags
  geolocationFullAccess Boolean @default(false) @map("geolocation_full_access")
  qrCodeAccess          Boolean @default(false) @map("qr_code_access")

  // Stripe
  stripeProductId      String? @unique @map("stripe_product_id")
  stripeAnnualPriceId  String? @unique @map("stripe_annual_price_id")
  stripeMonthlyPriceId String? @unique @map("stripe_monthly_price_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  coupons DiscountCoupon[] @relation("CouponSubscriptions")

  @@map("subscriptions")
}

model DiscountCoupon {
  id          String  @id @default(cuid())
  code        String  @unique
  description String?

  // Discount config
  discountType     String  @map("discount_type") // "percent" | "amount"
  discountValue    Decimal @map("discount_value") @db.Decimal(10, 2)
  duration         String // "once" | "forever" | "repeating"
  durationInMonths Int?    @map("duration_in_months")

  // Limits
  maxRedemptions Int?      @map("max_redemptions")
  redeemBy       DateTime? @map("redeem_by")

  // Scope — empty = all paid subs
  appliesTo Subscription[] @relation("CouponSubscriptions")

  // Stripe mirror
  stripeCouponId        String? @unique @map("stripe_coupon_id")
  stripePromotionCodeId String? @unique @map("stripe_promotion_code_id")

  // Audit
  createdById String  @map("created_by_id")
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("discount_coupons")
}

model Package {
  id          String  @id @default(cuid())
  name        String
  description String?
  price       Decimal @map("price") @db.Decimal(10, 2)
  quantity    Int     @default(1)
  isActive    Boolean @default(true) @map("is_active")

  // Stripe references — provisioned in SEQ via prisma/seed-stripe-packages.ts.
  // BMS only displays them; nullified by updatePackage if price changes.
  stripeProductId String? @unique @map("stripe_product_id")
  stripePriceId   String? @unique @map("stripe_price_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sales Sale[]

  @@map("packages")
}

model Sale {
  id       Int @id @default(autoincrement())
  quantity Int @default(1)

  packageId String  @map("package_id")
  package   Package @relation(fields: [packageId], references: [id], onDelete: Restrict)

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  soldById String @map("sold_by_id")
  soldBy   User   @relation(fields: [soldById], references: [id], onDelete: Restrict)

  stripeSessionId       String? @unique @map("stripe_session_id")
  stripePaymentIntentId String? @map("stripe_payment_intent_id")

  reversedAt DateTime? @map("reversed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sales")
}

model QrInventory {
  id       String @id @default(cuid())
  quantity Int    @default(0)

  tenantId String @unique @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("qr_inventory")
}

// ─── Auth tokens ─────────────────────────────────────────────────────────────

model RateLimitAttempt {
  id          Int      @id @default(autoincrement())
  key         String
  attemptedAt DateTime @default(now()) @map("attempted_at")

  @@index([key, attemptedAt])
  @@index([attemptedAt])
  @@map("rate_limit_attempts")
}

model EmailToken {
  id        String         @id @default(cuid())
  token     String         @unique
  type      EmailTokenType
  userId    String?        @map("user_id")
  newEmail  String?        @map("new_email")
  expiresAt DateTime       @map("expires_at")
  createdAt DateTime       @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  // app_user_id column exists in the shared DB (referenced by AppUser in SEQ/APP).
  // BMS does not declare AppUser, so the FK is not modeled as a Prisma relation
  // here; BMS code never reads or writes this column.
  appUserId String? @map("app_user_id")

  @@map("email_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String?  @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  appUserId String? @map("app_user_id")

  @@map("password_reset_tokens")
}

// ─── Address ─────────────────────────────────────────────────────────────────

model Address {
  id           String  @id @default(cuid())
  zip          String?
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?
  country      String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company  Company?
  user     User?
  supplier Supplier?
  tenant   Tenant?

  @@map("addresses")
}

// ─── Company ─────────────────────────────────────────────────────────────────

model Company {
  id                    String  @id @default(cuid())
  legalName             String  @map("legal_name")
  tradeName             String  @map("trade_name")
  taxId                 String  @unique @map("tax_id")
  stateRegistration     String? @map("state_registration")
  municipalRegistration String? @map("municipal_registration")
  email                 String  @unique
  phoneCountryCode      String  @default("55") @map("phone_country_code")
  phone                 String
  isActive              Boolean @default(true) @map("is_active")

  addressId String?  @unique @map("address_id")
  address   Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("companies")
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id                  String    @id @default(cuid())
  firstName           String    @map("first_name")
  lastName            String    @map("last_name")
  email               String    @unique
  password            String?
  role                Role      @default(USER)
  nationalId          String?   @map("national_id")
  birthDate           DateTime? @map("birth_date")
  gender              String?   @map("gender")
  avatarUrl           String?   @map("avatar_url")
  phoneCountryCode    String    @default("55") @map("phone_country_code")
  phone               String?
  isActive            Boolean   @default(true) @map("is_active")
  emailVerified       DateTime? @map("email_verified")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")

  tenantId String? @map("tenant_id")
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  addressId String?  @unique @map("address_id")
  address   Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  emailTokens         EmailToken[]
  passwordResetTokens PasswordResetToken[]
  sales               Sale[]

  @@map("users")
}

// ─── Supplier ────────────────────────────────────────────────────────────────

model SupplierCategory {
  id          String  @id @default(cuid())
  name        String
  description String?
  isActive    Boolean @default(true) @map("is_active")

  tenantId String? @map("tenant_id")
  tenant   Tenant? @relation("SupplierCategoryTenant", fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  suppliers Supplier[]

  @@unique([tenantId, name])
  @@map("supplier_categories")
}

model Supplier {
  id                    String     @id @default(cuid())
  entityType            EntityType @map("entity_type")
  name                  String
  tradeName             String     @map("trade_name")
  birthDate             DateTime?  @map("birth_date")
  taxId                 String     @unique @map("tax_id")
  stateRegistration     String?    @map("state_registration")
  municipalRegistration String?    @map("municipal_registration")
  email                 String
  phoneCountryCode      String     @default("55") @map("phone_country_code")
  phone                 String
  notes                 String?
  isActive              Boolean    @default(true) @map("is_active")

  categoryId String?           @map("category_id")
  category   SupplierCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  tenantId String? @map("tenant_id")
  tenant   Tenant? @relation("SupplierTenant", fields: [tenantId], references: [id], onDelete: Cascade)

  addressId String?  @unique @map("address_id")
  address   Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("suppliers")
}

// ─── Tenant ────────────────────────────────────────────────────────────────

model TenantCategory {
  id          String  @id @default(cuid())
  name        String
  description String?
  isActive    Boolean @default(true) @map("is_active")

  tenantId String? @map("tenant_id")
  tenant   Tenant? @relation("TenantCategoryTenant", fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenants   Tenant[] @relation("TenantCategory")

  @@unique([tenantId, name])
  @@map("tenant_categories")
}

model Tenant {
  id                    String     @id @default(cuid())
  entityType            EntityType @map("entity_type")
  name                  String
  tradeName             String     @map("trade_name")
  birthDate             DateTime?  @map("birth_date")
  taxId                 String     @unique @map("tax_id")
  stateRegistration     String?    @map("state_registration")
  municipalRegistration String?    @map("municipal_registration")
  email                 String
  phoneCountryCode      String     @default("55") @map("phone_country_code")
  phone                 String
  notes                 String?
  isActive              Boolean    @default(true) @map("is_active")

  moduleRecordsSuppliers    Boolean @default(false) @map("module_records_suppliers")
  moduleRecordsProducts     Boolean @default(false) @map("module_records_products")
  moduleRecordsServices     Boolean @default(false) @map("module_records_services")
  moduleCategoriesSuppliers Boolean @default(false) @map("module_categories_suppliers")
  moduleCategoriesProducts  Boolean @default(false) @map("module_categories_products")
  moduleCategoriesServices  Boolean @default(false) @map("module_categories_services")
  modulePurchasingProducts  Boolean @default(false) @map("module_purchasing_products")
  modulePurchasingServices  Boolean @default(false) @map("module_purchasing_services")
  moduleInventoryProducts   Boolean @default(false) @map("module_inventory_products")
  moduleFinance             Boolean @default(false) @map("module_finance")

  // Stripe customer reference for SEQ QR package purchases.
  stripeCustomerId String? @unique @map("stripe_customer_id")

  categoryId String?         @map("category_id")
  category   TenantCategory? @relation("TenantCategory", fields: [categoryId], references: [id], onDelete: SetNull)

  tenantId String? @map("tenant_id")
  tenant   Tenant? @relation("TenantParent", fields: [tenantId], references: [id], onDelete: Cascade)

  addressId String?  @unique @map("address_id")
  address   Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users        User[]
  subTenants   Tenant[]           @relation("TenantParent")
  suppliers    Supplier[]         @relation("SupplierTenant")
  supplierCats SupplierCategory[] @relation("SupplierCategoryTenant")
  tenantCats   TenantCategory[]   @relation("TenantCategoryTenant")
  sales        Sale[]
  qrInventory  QrInventory?

  @@map("tenants")
}
