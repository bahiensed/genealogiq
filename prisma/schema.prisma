generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  OWNER
  ADMIN
  COMERCIAL
  FINANCE
  USER
}

enum AppRole {
  APP_USER
  APP_MEMO
  APP_GHOST
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EmailTokenType {
  VERIFICATION
  CHANGE
}

enum TributeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EntityType {
  INDIVIDUAL
  COMPANY
}

// ─── Subscriptions & Packages ────────────────────────────────────────────────

model Subscription {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  isActive    Boolean @default(true) @map("is_active")

  // Commercial
  maxProfiles Int     @map("max_profiles")
  termLength  Int     @map("term_length")
  price       Decimal @db.Decimal(10, 2)

  // Feature limits
  treeMaxMembers   Int @map("tree_max_members")
  bioMaxChars      Int @map("bio_max_chars")
  bioMaxImages     Int @map("bio_max_images")
  galleryMaxImages Int @map("gallery_max_images")
  galleryMaxVideos Int @map("gallery_max_videos")

  // Feature flags
  geolocationFullAccess Boolean @default(false) @map("geolocation_full_access")
  qrCodeAccess          Boolean @default(false) @map("qr_code_access")

  // Stripe
  stripeProductId      String? @unique @map("stripe_product_id")
  stripeAnnualPriceId  String? @unique @map("stripe_annual_price_id")
  stripeMonthlyPriceId String? @unique @map("stripe_monthly_price_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  appSales AppSale[]

  @@map("subscriptions")
}

model DiscountCoupon {
  id          String  @id @default(cuid())
  code        String  @unique
  description String?

  // Discount config
  discountType     String  @map("discount_type") // "percent" | "amount"
  discountValue    Decimal @map("discount_value") @db.Decimal(10, 2)
  duration         String // "once" | "forever" | "repeating"
  durationInMonths Int?    @map("duration_in_months")

  // Limits
  maxRedemptions Int?      @map("max_redemptions")
  redeemBy       DateTime? @map("redeem_by")

  // Scope — empty = all active packages
  appliesTo Package[] @relation("CouponPackages")

  // Stripe mirror
  stripeCouponId        String? @unique @map("stripe_coupon_id")
  stripePromotionCodeId String? @unique @map("stripe_promotion_code_id")

  // Audit (createdById is a BMS User id, not an AppUser; not modeled as relation here)
  createdById String  @map("created_by_id")
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("discount_coupons")
}

enum PackageType {
  DIGITAL
  PHYSICAL
}

enum PhysicalQrStatus {
  AVAILABLE
  ACTIVATED
}

model Package {
  id          String      @id @default(cuid())
  name        String
  description String?
  price       Decimal     @map("price") @db.Decimal(10, 2)
  quantity    Int         @default(1)
  isActive    Boolean     @default(true) @map("is_active")
  type        PackageType @default(DIGITAL)

  // Stripe references owned by SEQ (provisioned via SEQ seed script).
  // Mirrored here so the Prisma client matches the shared DB schema.
  stripeProductId String? @unique @map("stripe_product_id")
  stripePriceId   String? @unique @map("stripe_price_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sales            Sale[]
  coupons          DiscountCoupon[]    @relation("CouponPackages")
  physicalLicenses PhysicalQrLicense[]

  @@map("packages")
}

model Sale {
  id       Int @id @default(autoincrement())
  quantity Int @default(1)

  packageId String  @map("package_id")
  package   Package @relation(fields: [packageId], references: [id], onDelete: Restrict)

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  soldById String @map("sold_by_id")
  soldBy   User   @relation(fields: [soldById], references: [id], onDelete: Restrict)

  stripeSessionId       String? @unique @map("stripe_session_id")
  stripePaymentIntentId String? @map("stripe_payment_intent_id")

  reversedAt DateTime? @map("reversed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  physicalLicenses PhysicalQrLicense[]

  @@map("sales")
}

model QrInventory {
  id       String @id @default(cuid())
  quantity Int    @default(0)

  tenantId String @unique @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("qr_inventory")
}

model AppSale {
  id String @id @default(cuid())

  // Legacy SEQUOIA fields (seller-driven QR-code sales). Nullable here because
  // Stripe direct purchases originating from the APP have no tenant or seller.
  value    Decimal? @db.Decimal(10, 2)
  tenantId String?  @map("tenant_id")
  soldById String?  @map("sold_by_id")

  appUserId String  @map("app_user_id")
  appUser   AppUser @relation("AppSaleBuyer", fields: [appUserId], references: [id], onDelete: Cascade)

  // Memorials assigned to this sale (up to subscription.maxProfiles)
  assignedTo AppUser[] @relation("AppSaleMemorial")

  subscriptionId String       @map("subscription_id")
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  // Stripe (NULLABLE so SEQ vendor sales — which never touch Stripe — coexist
  // in the same table as APP direct purchases).
  stripeSubscriptionId String? @unique @map("stripe_subscription_id")
  stripePriceId        String? @map("stripe_price_id")
  cadence              String? // "annual" | "monthly"

  // Lifecycle
  status            String? // "active" | "trialing" | "past_due" | "canceled" | "incomplete" | "unpaid"
  currentPeriodEnd  DateTime? @map("current_period_end")
  cancelAtPeriodEnd Boolean   @default(false) @map("cancel_at_period_end")
  canceledAt        DateTime? @map("canceled_at")
  endedAt           DateTime? @map("ended_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_sales")
}

model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("stripe_events")
}

// ─── Auth tokens ─────────────────────────────────────────────────────────────

model RateLimitAttempt {
  id          Int      @id @default(autoincrement())
  key         String
  attemptedAt DateTime @default(now()) @map("attempted_at")

  @@index([key, attemptedAt])
  @@index([attemptedAt])
  @@map("rate_limit_attempts")
}

model EmailToken {
  id        String         @id @default(cuid())
  token     String         @unique
  type      EmailTokenType
  userId    String?        @map("user_id")
  newEmail  String?        @map("new_email")
  expiresAt DateTime       @map("expires_at")
  createdAt DateTime       @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  appUserId String?  @map("app_user_id")
  appUser   AppUser? @relation(fields: [appUserId], references: [id], onDelete: Cascade)

  @@map("email_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String?  @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  appUserId String?  @map("app_user_id")
  appUser   AppUser? @relation(fields: [appUserId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// ─── Address ─────────────────────────────────────────────────────────────────

model Address {
  id           String  @id @default(cuid())
  zip          String?
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?
  country      String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company  Company?
  user     User?
  supplier Supplier?
  tenant   Tenant?
  appUser  AppUser?

  @@map("addresses")
}

// ─── Company ─────────────────────────────────────────────────────────────────

model Company {
  id                    String  @id @default(cuid())
  legalName             String  @map("legal_name")
  tradeName             String  @map("trade_name")
  taxId                 String  @unique @map("tax_id")
  stateRegistration     String? @map("state_registration")
  municipalRegistration String? @map("municipal_registration")
  email                 String  @unique
  phoneCountryCode      String  @default("55") @map("phone_country_code")
  phone                 String
  isActive              Boolean @default(true) @map("is_active")

  addressId String?  @unique @map("address_id")
  address   Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("companies")
}

// ─── User (BMS/SEQ operators only — não contém APP_USER/APP_MEMO) ─────────────

model User {
  id                  String    @id @default(cuid())
  firstName           String    @map("first_name")
  lastName            String    @map("last_name")
  email               String    @unique
  password            String?
  role                Role      @default(USER)
  nationalId          String?   @map("national_id")
  birthDate           DateTime? @map("birth_date")
  gender              String?   @map("gender")
  avatarUrl           String?   @map("avatar_url")
  phoneCountryCode    String    @default("55") @map("phone_country_code")
  phone               String?
  isActive            Boolean   @default(true) @map("is_active")
  emailVerified       DateTime? @map("email_verified")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")

  tenantId String? @map("tenant_id")
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  addressId String?  @unique @map("address_id")
  address   Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  emailTokens         EmailToken[]
  passwordResetTokens PasswordResetToken[]
  sales               Sale[]

  @@map("users")
}

// ─── AppUser ──────────────────────────────────────────────────────────────────

model AppUser {
  id   String  @id @default(cuid())
  role AppRole @default(APP_USER)

  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  maidenName   String?   @map("maiden_name")
  nickname     String?
  gender       Gender?
  birthDate    DateTime? @map("birth_date")
  birthPlace   String?   @map("birth_place")
  birthCity    String?   @map("birth_city")
  birthState   String?   @map("birth_state")
  birthCountry String?   @map("birth_country")
  avatarUrl    String?   @map("avatar_url")
  nationalId   String?   @map("national_id")
  notes        String?

  deathDate    DateTime? @map("death_date")
  deathPlace   String?   @map("death_place")
  deathState   String?   @map("death_state")
  deathCountry String?   @map("death_country")
  deathCause   String?   @map("death_cause")

  // Auth (only APP_USER that can log in)
  email               String?
  password            String?
  emailVerified       DateTime? @map("email_verified")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  isActive            Boolean   @default(true) @map("is_active")

  phoneCountryCode String  @default("55") @map("phone_country_code")
  phone            String?
  fb               String?
  instagram        String?
  linkedin         String?
  tiktok           String?
  x                String?
  youtube          String?
  otherSocial      String? @map("other_social")
  website          String?

  tenantId String? @map("tenant_id")
  tenant   Tenant? @relation("AppUserTenant", fields: [tenantId], references: [id], onDelete: Cascade)

  addressId String?  @unique @map("address_id")
  address   Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Guardian relationships
  guardiansOf          AppUserGuardian[] @relation("GuardianOf")
  guardedBy            AppUserGuardian[] @relation("GuardedBy")
  guardianRequestsMade AppUserGuardian[] @relation("GuardianRequestedBy")

  // APP-specific content
  // userId field on each model maps to app_user_id column (kept for minimal code churn)
  bio               Bio?
  galleryItems      GalleryItem[]
  tributesAuthored  Tribute[]        @relation("TributeAuthor")
  tributesReceived  Tribute[]        @relation("TributeProfile")
  favoritesGiven    Favorite[]       @relation("FavoriteUser")
  favoritesReceived Favorite[]       @relation("FavoriteTarget")
  geolocation       Geolocation?
  familyFrom        FamilyRelation[] @relation("FamilyFrom")
  familyTo          FamilyRelation[] @relation("FamilyTo")

  notifications      Notification[] @relation("UserNotifications")
  actorNotifications Notification[] @relation("ActorNotifications")

  // Stripe Customer (one per AppUser, created on first checkout)
  stripeCustomerId String? @unique @map("stripe_customer_id")

  // Sales (QR codes acquired via SEQUOIA — buyer side)
  appSales AppSale[] @relation("AppSaleBuyer")

  // QR-Code (sale) assigned to this memorial (null = free-tier memorial).
  // Multiple memorials can point to the same sale, up to subscription.maxProfiles.
  appSaleId String?  @map("app_sale_id")
  appSale   AppSale? @relation("AppSaleMemorial", fields: [appSaleId], references: [id], onDelete: SetNull)

  // Auth tokens
  emailTokens         EmailToken[]
  passwordResetTokens PasswordResetToken[]

  qrCode            QrCode?
  physicalQrLicense PhysicalQrLicense?

  @@index([tenantId])
  @@map("app_users")
}

model AppUserGuardian {
  id String @id @default(cuid())

  appUserId String  @map("app_user_id")
  appUser   AppUser @relation("GuardedBy", fields: [appUserId], references: [id], onDelete: Cascade)

  guardianId String  @map("guardian_id")
  guardian   AppUser @relation("GuardianOf", fields: [guardianId], references: [id], onDelete: Cascade)

  // Co-guardianship requests workflow:
  // - Ghosts created by their guardian start ACCEPTED.
  // - Requests submitted by another user start PENDING; an existing guardian
  //   approves (status -> ACCEPTED) or rejects (row deleted).
  status        GuardianStatus @default(ACCEPTED)
  requestedById String?        @map("requested_by_id")
  requestedBy   AppUser?       @relation("GuardianRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)

  notifications Notification[]

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([appUserId, guardianId])
  @@index([appUserId])
  @@index([guardianId])
  @@map("app_user_guardians")
}

enum GuardianStatus {
  PENDING
  ACCEPTED
}

enum QrStatus {
  PENDING
  PRINTED
  INSTALLED
}

// ─── Bio ─────────────────────────────────────────────────────────────────────

model Bio {
  id    String  @id @default(cuid())
  quote String? @db.VarChar(140)
  text  String? @db.Text

  // userId maps to app_user_id column (kept name to avoid cascading code changes)
  userId String  @unique @map("app_user_id")
  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  images BioImage[]

  @@map("app_bios")
}

model BioImage {
  id     String @id @default(cuid())
  url    String
  aspect String @default("square")
  order  Int    @default(0)

  bioId String @map("bio_id")
  bio   Bio    @relation(fields: [bioId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([bioId])
  @@map("app_bio_images")
}

// ─── Tributes ────────────────────────────────────────────────────────────────

model Tribute {
  id       String        @id @default(cuid())
  text     String        @db.VarChar(512)
  imageUrl String?       @map("image_url")
  status   TributeStatus @default(PENDING)

  // authorId/profileId map to app_author_id/app_profile_id columns
  authorId String  @map("app_author_id")
  author   AppUser @relation("TributeAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  profileId String  @map("app_profile_id")
  profile   AppUser @relation("TributeProfile", fields: [profileId], references: [id], onDelete: Cascade)

  notifications Notification[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([authorId, profileId])
  @@index([authorId])
  @@index([profileId])
  @@map("app_tributes")
}

// ─── Gallery ─────────────────────────────────────────────────────────────────

model GalleryItem {
  id          String  @id @default(cuid())
  kind        String  @default("image")
  url         String
  poster      String?
  durationSec Float?  @map("duration_sec")
  takenAt     String? @map("taken_at")
  location    String?
  description String? @db.VarChar(280)
  order       Int     @default(0)

  // userId maps to app_user_id column
  userId String  @map("app_user_id")
  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("app_gallery_items")
}

// ─── Favorites ───────────────────────────────────────────────────────────────

model Favorite {
  // userId/targetId map to app_user_id/app_target_id columns
  userId String  @map("app_user_id")
  user   AppUser @relation("FavoriteUser", fields: [userId], references: [id], onDelete: Cascade)

  targetId String  @map("app_target_id")
  target   AppUser @relation("FavoriteTarget", fields: [targetId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, targetId])
  @@map("app_favorites")
}

// ─── Geolocation ─────────────────────────────────────────────────────────────

model Geolocation {
  id           String    @id @default(cuid())
  placeName    String    @map("place_name") @db.VarChar(120)
  // Legacy free-form address (kept for backward compatibility — superseded by structured fields below)
  address      String?   @db.VarChar(200)
  zip          String?
  street       String?   @db.VarChar(200)
  number       String?   @db.VarChar(20)
  complement   String?   @db.VarChar(200)
  neighborhood String?   @db.VarChar(100)
  city         String?   @db.VarChar(100)
  state        String?   @db.VarChar(100)
  country      String?   @db.VarChar(100)
  section      String?   @db.VarChar(200)
  lat          Float
  lon          Float
  date         DateTime?
  notes        String?   @db.VarChar(500)
  photo1       String?   @map("photo_1")
  photo2       String?   @map("photo_2")
  photo3       String?   @map("photo_3")

  // userId maps to app_user_id column
  userId String  @unique @map("app_user_id")
  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_geolocations")
}

// ─── Family Tree ─────────────────────────────────────────────────────────────

model FamilyRelation {
  id      String  @id @default(cuid())
  type    String  @map("type")
  subtype String? @map("subtype")

  // fromId/toId map to app_from_id/app_to_id columns
  fromId String  @map("app_from_id")
  from   AppUser @relation("FamilyFrom", fields: [fromId], references: [id], onDelete: Cascade)

  toId String  @map("app_to_id")
  to   AppUser @relation("FamilyTo", fields: [toId], references: [id], onDelete: Cascade)

  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")

  // Pending tree-member invitations awaiting the target's consent.
  status        String  @default("ACCEPTED") @map("status")
  requestedById String? @map("requested_by")

  notifications Notification[]

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([fromId, toId, type])
  @@index([fromId])
  @@index([toId])
  @@map("app_family_relations")
}

// ─── Notifications ───────────────────────────────────────────────────────────

enum NotificationType {
  TRIBUTE_PENDING
  TRIBUTE_APPROVED
  TRIBUTE_REJECTED
  FAMILY_REQUEST_PENDING
  FAMILY_REQUEST_ACCEPTED
  FAMILY_REQUEST_REJECTED
  GUARDIAN_REQUEST_PENDING
  GUARDIAN_REQUEST_ACCEPTED
  GUARDIAN_REQUEST_REJECTED
}

model Notification {
  id   String           @id @default(cuid())
  type NotificationType

  userId String  @map("user_id")
  user   AppUser @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  actorId String?  @map("actor_id")
  actor   AppUser? @relation("ActorNotifications", fields: [actorId], references: [id], onDelete: SetNull)

  tributeId String?  @map("tribute_id")
  tribute   Tribute? @relation(fields: [tributeId], references: [id], onDelete: Cascade)

  familyRelationId String?         @map("family_relation_id")
  familyRelation   FamilyRelation? @relation(fields: [familyRelationId], references: [id], onDelete: Cascade)

  appUserGuardianId String?          @map("app_user_guardian_id")
  appUserGuardian   AppUserGuardian? @relation(fields: [appUserGuardianId], references: [id], onDelete: Cascade)

  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([appUserGuardianId])
  @@map("app_notifications")
}

// ─── Supplier ────────────────────────────────────────────────────────────────

model SupplierCategory {
  id          String  @id @default(cuid())
  name        String
  description String?
  isActive    Boolean @default(true) @map("is_active")

  tenantId String? @map("tenant_id")
  tenant   Tenant? @relation("SupplierCategoryTenant", fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  suppliers Supplier[]

  @@unique([tenantId, name])
  @@map("supplier_categories")
}

model Supplier {
  id                    String     @id @default(cuid())
  entityType            EntityType @map("entity_type")
  name                  String
  tradeName             String     @map("trade_name")
  birthDate             DateTime?  @map("birth_date")
  taxId                 String     @unique @map("tax_id")
  stateRegistration     String?    @map("state_registration")
  municipalRegistration String?    @map("municipal_registration")
  email                 String
  phoneCountryCode      String     @default("55") @map("phone_country_code")
  phone                 String
  notes                 String?
  isActive              Boolean    @default(true) @map("is_active")

  categoryId String?           @map("category_id")
  category   SupplierCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  tenantId String? @map("tenant_id")
  tenant   Tenant? @relation("SupplierTenant", fields: [tenantId], references: [id], onDelete: Cascade)

  addressId String?  @unique @map("address_id")
  address   Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("suppliers")
}

// ─── Tenant ────────────────────────────────────────────────────────────────

model TenantCategory {
  id          String  @id @default(cuid())
  name        String
  description String?
  isActive    Boolean @default(true) @map("is_active")

  tenantId String? @map("tenant_id")
  tenant   Tenant? @relation("TenantCategoryTenant", fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenants   Tenant[] @relation("TenantCategory")

  @@unique([tenantId, name])
  @@map("tenant_categories")
}

model Tenant {
  id                    String     @id @default(cuid())
  entityType            EntityType @map("entity_type")
  name                  String
  tradeName             String     @map("trade_name")
  birthDate             DateTime?  @map("birth_date")
  taxId                 String     @unique @map("tax_id")
  stateRegistration     String?    @map("state_registration")
  municipalRegistration String?    @map("municipal_registration")
  email                 String
  phoneCountryCode      String     @default("55") @map("phone_country_code")
  phone                 String
  notes                 String?
  isActive              Boolean    @default(true) @map("is_active")

  moduleRecordsSuppliers    Boolean @default(false) @map("module_records_suppliers")
  moduleRecordsProducts     Boolean @default(false) @map("module_records_products")
  moduleRecordsServices     Boolean @default(false) @map("module_records_services")
  moduleCategoriesSuppliers Boolean @default(false) @map("module_categories_suppliers")
  moduleCategoriesProducts  Boolean @default(false) @map("module_categories_products")
  moduleCategoriesServices  Boolean @default(false) @map("module_categories_services")
  modulePurchasingProducts  Boolean @default(false) @map("module_purchasing_products")
  modulePurchasingServices  Boolean @default(false) @map("module_purchasing_services")
  moduleInventoryProducts   Boolean @default(false) @map("module_inventory_products")
  moduleFinance             Boolean @default(false) @map("module_finance")

  // Stripe customer reference owned by SEQ (QR package billing per tenant).
  stripeCustomerId String? @unique @map("stripe_customer_id")

  categoryId String?         @map("category_id")
  category   TenantCategory? @relation("TenantCategory", fields: [categoryId], references: [id], onDelete: SetNull)

  tenantId String? @map("tenant_id")
  tenant   Tenant? @relation("TenantParent", fields: [tenantId], references: [id], onDelete: Cascade)

  addressId String?  @unique @map("address_id")
  address   Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users        User[]
  appUsers     AppUser[]          @relation("AppUserTenant")
  subTenants   Tenant[]           @relation("TenantParent")
  suppliers    Supplier[]         @relation("SupplierTenant")
  supplierCats SupplierCategory[] @relation("SupplierCategoryTenant")
  tenantCats   TenantCategory[]   @relation("TenantCategoryTenant")
  sales            Sale[]
  qrInventory      QrInventory?
  physicalLicenses PhysicalQrLicense[]

  @@map("tenants")
}

model QrCode {
  id            String    @id @default(cuid())
  url           String
  status        QrStatus  @default(PENDING)
  printedAt     DateTime? @map("printed_at")
  installedAt   DateTime? @map("installed_at")
  scanCount     Int       @default(0) @map("scan_count")
  lastScannedAt DateTime? @map("last_scanned_at")

  appUserId     String    @unique @map("app_user_id")
  appUser       AppUser   @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  scans         QrScan[]

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("qr_codes")
}

model QrScan {
  id        String   @id @default(cuid())
  qrCodeId  String   @map("qr_code_id")
  qrCode    QrCode   @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  scannedAt DateTime @default(now()) @map("scanned_at")
  userAgent String?  @map("user_agent") @db.VarChar(512)
  ipHash    String?  @map("ip_hash")

  @@index([qrCodeId])
  @@index([scannedAt])
  @@map("qr_scans")
}

// ─── Physical QR Code Licenses ───────────────────────────────────────────────

model PhysicalQrLicense {
  id      String           @id @default(cuid())
  genCode String           @unique @map("gen_code")
  status  PhysicalQrStatus @default(AVAILABLE)

  saleId    Int     @map("sale_id")
  sale      Sale    @relation(fields: [saleId],    references: [id], onDelete: Restrict)
  packageId String  @map("package_id")
  package   Package @relation(fields: [packageId], references: [id], onDelete: Restrict)
  tenantId  String  @map("tenant_id")
  tenant    Tenant  @relation(fields: [tenantId],  references: [id], onDelete: Restrict)

  // Set on activation — the APP_MEMO memorial created by the end-user.
  appUserId   String?  @unique @map("app_user_id")
  appUser     AppUser? @relation(fields: [appUserId], references: [id], onDelete: SetNull)
  activatedAt DateTime? @map("activated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@index([tenantId, status])
  @@map("physical_qr_licenses")
}
