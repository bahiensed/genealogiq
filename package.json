{
  "name": "genealogiq",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "turbo run db:generate",
    "db:migrate:deploy": "pnpm --filter @genealogiq/db db:migrate:deploy",
    "db:migrate:status": "pnpm --filter @genealogiq/db db:migrate:status",
    "check:schema-parity": "node scripts/check-schema-parity.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:i18n-parity": "node scripts/check-i18n-parity.mjs",
    "check:i18n-keys": "node scripts/check-i18n-keys.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "seed:e2e": "tsx e2e/seed.ts",
    "db:reset:transactional": "node --env-file=packages/db/.env scripts/reset-transactional-data.mjs"
  },
  "devDependencies": {
    "@genealogiq/db": "workspace:*",
    "@playwright/test": "^1.62.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.7",
    "pg": "^8.23.0",
    "tsx": "^4.23.12",
    "turbo": "^2.10.11",
    "vitest": "^3.2.7"
  }
}
