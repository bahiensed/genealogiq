# urls
APP_URL="https://genealogiq.app"
BMS_URL="https://bms.genealogiq.app"
SEQUOIA_URL="https://sequoia.rip"

# host
AUTH_TRUST_HOST=true

# prisma (shared Neon Postgres — same DATABASE_URL across the 3 apps)
DATABASE_URL=

# auth
# AUTH_URL is intentionally unset in dev, AUTH_TRUST_HOST=true handles port flexibility.
# In production set AUTH_URL=https://genealogiq.app
AUTH_SECRET=

# vercel blob
BLOB_READ_WRITE_TOKEN=

# resend
RESEND_API_KEY=

# stripe (subscription checkout + webhook)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# sentry (observability) — provisioned by a human in sentry.io; never commit real values.
# NEXT_PUBLIC_SENTRY_DSN is per-app (public by design). SENTRY_AUTH_TOKEN/ORG/PROJECT
# are set in the Vercel project env for source-map upload at build time (no-op without them).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
