# Transitional during the npm -> pnpm migration.
#
# The apps were written under npm's flat/hoisted node_modules and import some
# packages they don't declare directly (phantom deps), e.g. sub-packages of
# `radix-ui` like `@radix-ui/react-avatar`. pnpm's strict isolation surfaces
# these as "Cannot find module" errors.
#
# `shamefully-hoist` reproduces npm's flat layout so the migration is unblocked
# without touching app code. FOLLOW-UP (Phase 5 / dedicated cleanup): declare the
# real dependencies in each app's package.json and remove this flag to regain
# pnpm's strictness (which catches phantom deps and version drift).
shamefully-hoist=true
